{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/mcp.html",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg",
      "/*.ico"
    ]
  },
  "routes": [
    { "route": "/mcp.html", "serve": "/mcp.html" },
    { "route": "/index.html", "serve": "/index.html" }
  ]
}
